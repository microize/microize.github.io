{#
  Masthead — sticky site header shared by every page.
  Ported from the design system's Masthead.jsx + shell.js NAV: wordmark
  left, nav + theme toggle right. Hover/active state is plain CSS here
  (no React state); the toggle icon swap is a `[data-theme="dark"]` CSS
  selector instead of Masthead.jsx's `theme` prop.
  Pass `active` = "Resume" | "Portfolio" | "Blog" | "Contact" from the
  page's front matter to mark the current nav item.
#}
<header class="masthead">
  <div class="masthead-in">
    <a class="wordmark" href="/">Sripathi Mohanasundaram</a>
    <div class="mast-right">
      <nav class="mast-nav" aria-label="Primary">
        <a href="/resume/"{% if active == "Resume" %} aria-current="page"{% endif %}>Resume</a>
        <a href="/work/"{% if active == "Portfolio" %} aria-current="page"{% endif %}>Portfolio</a>
        <a href="/blog/"{% if active == "Blog" %} aria-current="page"{% endif %}>Blog</a>
        <a href="/contact/"{% if active == "Contact" %} aria-current="page"{% endif %}>Contact</a>
      </nav>
      <button type="button" class="theme-toggle" id="theme-toggle" title="Toggle theme" aria-label="Toggle theme">
        <svg class="theme-toggle-icon icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z"/></svg>
        <svg class="theme-toggle-icon icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>
