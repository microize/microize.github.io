---
layout: base.njk
active: Blog
noFooter: true
---
{% set nav = collections.posts | postNav(page.url) %}
{% set more = collections.posts | otherPosts(page.url, 3) %}

<main id="main-content" class="column reader">
  <article class="article">
    <header class="article-header">
      {% if tags and tags.length %}<span class="article-category">{{ tags[0] | titleCase }}</span>{% endif %}
      <h1 class="article-title">{{ title }}</h1>
      {% if excerpt %}<p class="article-deck">{{ excerpt | mdInline | safe }}</p>{% endif %}
      <div class="article-byline">
        <span class="article-byline-name">Sripathi Mohanasundaram</span>
        <span aria-hidden="true">·</span>
        <span>{{ date | dateDisplay }} · {{ content | readingTime }}</span>
      </div>
    </header>

    <div class="ds-prose">
      {{ content | safe }}
    </div>
  </article>

  <div class="reader-foot">
    {% if tags and tags.length %}
    <div class="topics">
      {% for tag in tags %}
      <a class="topic" href="/blog/">{{ tag | titleCase }}</a>
      {% endfor %}
    </div>
    <hr class="rule">
    {% endif %}

    <div class="author-note">
      <span class="author-avatar">SM</span>
      <div>
        <p class="author-name">Written by Sripathi Mohanasundaram</p>
        <p class="author-bio">Senior Data Engineer at Fractal Analytics. Writing about data platforms, Generative AI, and the craft of reliable data engineering.</p>
      </div>
    </div>
    <hr class="rule">

    {% if more.length %}
    <p class="eyebrow more-from-label">More from Sripathi Mohanasundaram</p>
    <div>
      {% for post in more %}
      <a class="row-link" href="{{ post.url }}">
        <h3>{{ post.data.title }}</h3>
        {% if post.data.excerpt %}<p>{{ post.data.excerpt | mdInline | safe }}</p>{% endif %}
        <div class="row-meta">{{ post.data.date | dateDisplay }} · {{ post.templateContent | readingTime }}</div>
      </a>
      {% endfor %}
    </div>
    {% endif %}

    <div class="reader-nav">
      {% if nav.prev %}<a href="{{ nav.prev.url }}">← {{ nav.prev.data.title }}</a>{% else %}<span></span>{% endif %}
      {% if nav.next %}<a href="{{ nav.next.url }}">{{ nav.next.data.title }} →</a>{% endif %}
    </div>
  </div>
</main>
