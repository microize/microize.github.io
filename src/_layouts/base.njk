<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}Sripathi Mohanasundaram - Personal Portfolio</title>

    <!-- Favicon: pastel-violet "S" monogram, matching the design system's palette -->
    <link rel="shortcut icon" href="/assets/images/fav_log.ico" type="image/x-icon">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon_io/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon_io/apple-touch-icon.png">
    <link rel="manifest" href="/assets/images/favicon_io/site.webmanifest">

    <!-- Design tokens (colors, typography, spacing, grid, self-hosted Pretendard) -->
    <link rel="stylesheet" href="/assets/css/tokens.css?v=1">

    <!-- Component & page CSS -->
    <link rel="stylesheet" href="/assets/css/style.css?v=17">

    <!-- Google Fonts: Newsreader (display serif) + IBM Plex Mono (code/keycaps). Pretendard is self-hosted via tokens.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Preload Critical Assets -->
    <link rel="preload" as="image" href="/assets/images/my-avatar.png">

    {% if description %}
    <meta name="description" content="{{ description }}">
    {% endif %}

    <!-- Canonical URL on the live domain (CNAME: sripathim.com) -->
    <link rel="canonical" href="https://sripathim.com{{ page.url }}">

    <!-- Open Graph -->
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}Sripathi Mohanasundaram - Architect{% endif %}">

    <script>
      // Prevent Flash of Unstyled Content
      try {
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    </script>
    {% if description %}
    <meta property="og:description" content="{{ description }}">
    {% endif %}
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://sripathim.com{{ page.url }}">
    <meta property="og:site_name" content="Sripathi Mohanasundaram">
    <meta property="og:image" content="https://sripathim.com/assets/images/my-avatar.png">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@SripathiMohana1">

    <!-- Structured Data for SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://sripathim.com/#person",
          "name": "Sripathi Mohanasundaram",
          "jobTitle": "Data & AI Architect",
          "description": "Data & AI Architect at Fractal, architecting the enterprise ontology and semantic layer that AI agents query instead of raw tables. Ten years across supply chain and logistics, consumer goods, retail and energy.",
          "url": "https://sripathim.com/",
          "image": "https://sripathim.com/assets/images/my-avatar.png",
          "worksFor": {
            "@type": "Organization",
            "name": "Fractal"
          },
          "sameAs": [
            "https://www.linkedin.com/in/sripathi-mohanasundaram/",
            "https://github.com/microize",
            "https://twitter.com/SripathiMohana1"
          ],
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Chennai",
            "addressRegion": "Tamil Nadu",
            "addressCountry": "India"
          },
          "alumniOf": "Chettinad College of Engineering & Technology",
          "knowsAbout": [
            "Enterprise Data Architecture",
            "Enterprise Ontology",
            "Semantic Layer",
            "Data Governance",
            "Data Modeling",
            "Databricks",
            "Azure",
            "AI Agents",
            "Generative AI",
            "Supply Chain and Logistics"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://sripathim.com/#website",
          "url": "https://sripathim.com/",
          "name": "Sripathi Mohanasundaram - Personal Portfolio",
          "description": "Portfolio and blog of Sripathi Mohanasundaram, Data & AI Architect specialising in enterprise ontology, semantic layers and AI on enterprise data",
          "publisher": {
            "@id": "https://sripathim.com/#person"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://sripathim.com/blog/?search={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
        {% if title and page.url.includes('/blog/') %}
        ,{
          "@type": "Article",
          "@id": {{ ("https://sripathim.com" ~ page.url ~ "#article") | dump | safe }},
          "headline": {{ title | dump | safe }},
          "description": {{ (description or (excerpt | stripMd)) | dump | safe }},
          "author": {
            "@id": "https://sripathim.com/#person"
          },
          "publisher": {
            "@id": "https://sripathim.com/#person"
          },
          {% if date %}"datePublished": {{ (date | dateISO) | dump | safe }},
          "dateModified": {{ (date | dateISO) | dump | safe }},{% endif %}
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": {{ ("https://sripathim.com" ~ page.url) | dump | safe }}
          },
          "url": {{ ("https://sripathim.com" ~ page.url) | dump | safe }},
          {% if tags %}
          "keywords": [
            {% for tag in tags %}{{ tag | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}
          ],
          {% endif %}
          "articleSection": "Technology",
          "inLanguage": "en-US"
        }
        {% endif %}
      ]
    }
    </script>
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    {% include "masthead.njk" %}

    {{ content | safe }}

    {% if not noFooter %}
    {% include "footer.njk" %}
    {% endif %}

    {% include "bottom-nav.njk" %}

    <!-- custom js link -->
    <script src="/assets/js/theme.js?v=3"></script>
    <script src="/assets/js/script.js?v=5"></script>

    <!-- Lucide icons (design system's icon set) -->
    <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
