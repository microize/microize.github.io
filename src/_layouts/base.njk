<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}Sripathi Mohanasundaram - Personal Portfolio</title>

    <!-- Favicon: pastel-violet "S" monogram, matching the design system's palette -->
    <link rel="shortcut icon" href="/assets/images/fav_log.ico" type="image/x-icon">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon_io/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon_io/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon_io/apple-touch-icon.png">
    <link rel="manifest" href="/assets/images/favicon_io/site.webmanifest">

    <!-- Design tokens (colors, typography, spacing, grid, self-hosted Pretendard) -->
    <link rel="stylesheet" href="/assets/css/tokens.css?v=1">

    <!-- Component & page CSS -->
    <link rel="stylesheet" href="/assets/css/style.css?v=11">

    <!-- Google Fonts: Newsreader (display serif) + IBM Plex Mono (code/keycaps). Pretendard is self-hosted via tokens.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Preload Critical Assets -->
    <link rel="preload" as="image" href="/assets/images/my-avatar.png">

    {% if description %}
    <meta name="description" content="{{ description }}">
    {% endif %}

    <!-- Open Graph -->
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}Sripathi Mohanasundaram - Senior Data Engineer{% endif %}">

    <script>
      // Prevent Flash of Unstyled Content
      try {
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    </script>
    {% if description %}
    <meta property="og:description" content="{{ description }}">
    {% endif %}
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url }}">

    <!-- Structured Data for SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://microize.github.io/#person",
          "name": "Sripathi Mohanasundaram",
          "jobTitle": "Senior Data Engineer",
          "description": "Senior Data Engineer with 8+ years transforming data landscapes across retail, energy, and tech sectors",
          "url": "https://microize.github.io/",
          "image": "https://microize.github.io/assets/images/my-avatar.png",
          "sameAs": [
            "https://www.linkedin.com/in/sripathi-mohanasundaram/",
            "https://github.com/microize",
            "https://www.kaggle.com/microize",
            "https://twitter.com/SripathiMohana1"
          ],
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Chennai",
            "addressRegion": "Tamil Nadu",
            "addressCountry": "India"
          },
          "alumniOf": "Anna University",
          "knowsAbout": [
            "Data Engineering",
            "Azure",
            "Python",
            "Machine Learning",
            "Databricks",
            "GenAI",
            "Leadership"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://microize.github.io/#website",
          "url": "https://microize.github.io/",
          "name": "Sripathi Mohanasundaram - Personal Portfolio",
          "description": "Portfolio and blog of Sripathi Mohanasundaram, Senior Data Engineer specializing in AI, Azure, and data platform leadership",
          "publisher": {
            "@id": "https://microize.github.io/#person"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://microize.github.io/blog/?search={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
        {% if title and page.url.includes('/blog/') %}
        ,{
          "@type": "Article",
          "@id": {{ (page.url ~ "#article") | dump | safe }},
          "headline": {{ title | dump | safe }},
          "description": {{ (description or (excerpt | stripMd)) | dump | safe }},
          "author": {
            "@id": "https://microize.github.io/#person"
          },
          "publisher": {
            "@id": "https://microize.github.io/#person"
          },
          {% if date %}"datePublished": {{ (date | dateISO) | dump | safe }},
          "dateModified": {{ (date | dateISO) | dump | safe }},{% endif %}
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": {{ page.url | dump | safe }}
          },
          "url": {{ page.url | dump | safe }},
          {% if tags %}
          "keywords": [
            {% for tag in tags %}{{ tag | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}
          ],
          {% endif %}
          "articleSection": "Technology",
          "inLanguage": "en-US"
        }
        {% endif %}
      ]
    }
    </script>
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    {% include "masthead.njk" %}

    {{ content | safe }}

    {% if not noFooter %}
    {% include "footer.njk" %}
    {% endif %}

    <!-- custom js link -->
    <script src="/assets/js/theme.js?v=3"></script>
    <script src="/assets/js/script.js?v=3"></script>

    <!-- Lucide icons (design system's icon set) -->
    <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
