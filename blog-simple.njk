---
layout: base.njk
title: Blog
active: Blog
description: "Writing from Sripathi Mohanasundaram on data engineering, Generative AI, hackathons and building software with AI."
pagination:
  data: collections.posts
  size: 6
  alias: posts
permalink: "/blog/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<main id="main-content" class="page">
  <section class="page-intro">
    <p class="eyebrow">Writing</p>
    <h1 class="page-intro-title">Notes on data platforms, GenAI and building with intention.</h1>
    <p class="page-intro-lede">Field notes from data engineering, Generative AI hackathons, and the craft of building software — the operational detail that rarely makes it into documentation.</p>
  </section>

  {% if collections.posts.length == 0 %}
  <section class="section">
    <div class="empty-state">
      <div class="empty-state-icon"><i data-lucide="file-text" width="40" height="40" stroke-width="2"></i></div>
      <h3>No articles yet</h3>
      <p>Check back soon for new writing.</p>
    </div>
  </section>
  {% else %}

  {% set latest = posts.slice(0, 3) %}
  {% set archive = posts.slice(3) %}
  {% set pastels = ['sky', 'mint', 'sand', 'violet', 'peach', 'leaf'] %}

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Latest</p>
      <span class="meta-mono">{{ collections.posts.length }} post{% if collections.posts.length != 1 %}s{% endif %}</span>
    </div>
    <div class="tile-grid" style="margin-top:32px">
      {% for post in latest %}
      <div>
        <div class="thumb pastel-{{ pastels[loop.index0 % pastels.length] }}">{{ post.data.title }}</div>
        <a class="blog-card" href="{{ post.url }}">
          <h3 class="blog-card-title">{{ post.data.title }}</h3>
          <div class="blog-card-meta">{{ post.data.date | dateDisplay }} · {{ post.templateContent | readingTime }}</div>
        </a>
      </div>
      {% endfor %}
    </div>
  </section>

  {% if archive.length > 0 %}
  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Archive</p>
    </div>
    <div class="index-rows" style="margin-top:24px">
      {% for post in archive %}
      <a class="index-row index-row-compact pastel-{{ pastels[loop.index0 % pastels.length] }}" href="{{ post.url }}">
        <div class="index-row-body">
          <h3 class="index-row-title">{{ post.data.title }}</h3>
          {% if post.data.excerpt %}<p class="index-row-desc">{{ post.data.excerpt | mdInline | safe }}</p>{% endif %}
        </div>
        <div class="index-row-aside">{{ post.data.date | dateDisplay }}<br>{{ post.templateContent | readingTime }}</div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if pagination.href.previous or pagination.href.next %}
  <nav class="pagination section">
    <div class="pagination-info">
      <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.hrefs.length }}</span>
      <span class="pagination-sep">·</span>
      <span>{{ posts.length }} of {{ collections.posts.length }} articles</span>
    </div>
    <div class="pagination-controls">
      {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="pagination-btn">← Previous</a>
      {% endif %}
      <div class="pagination-numbers">
        {% for pageHref in pagination.hrefs %}
        <a href="{{ pageHref }}" class="pagination-number{% if loop.index0 == pagination.pageNumber %} active{% endif %}">{{ loop.index }}</a>
        {% endfor %}
      </div>
      {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="pagination-btn">Next →</a>
      {% endif %}
    </div>
  </nav>
  {% endif %}

  {% endif %}
</main>
