{
  "name": "sripathi-portfolio",
  "version": "1.0.0",
  "description": "Sripathi Mohanasundaram's Data Engineering Portfolio",
  "scripts": {
    "build:eleventy": "eleventy",
    "build:css": "cleancss -o _site/assets/css/style.css assets/css/style.css",
    "build:js": "terser assets/js/script.js -o _site/assets/js/script.js -c -m && terser assets/js/theme.js -o _site/assets/js/theme.js -c -m && terser assets/js/data-flow-game.js -o _site/assets/js/data-flow-game.js -c -m",
    "build": "npm run build:eleventy && npm run build:css && npm run build:js",
    "serve": "eleventy --serve",
    "start": "eleventy --serve",
    "debug": "DEBUG=Eleventy* eleventy"
  },
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.2.0",
    "markdown-it": "^13.0.1",
    "markdown-it-anchor": "^8.6.7"
  },
  "keywords": [
    "portfolio",
    "data-engineering",
    "eleventy",
    "blog"
  ],
  "author": "Sripathi Mohanasundaram",
  "license": "MIT",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "html-minifier": "^4.0.0",
    "terser": "^5.46.0"
  }
}
